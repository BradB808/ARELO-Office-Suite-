{
  "name": "anleo-office",
  "productName": "Anleo Office",
  "version": "1.2.0",
  "description": "A completely free, offline office suite \u2014 documents, spreadsheets, and presentations in one app.",
  "author": "Anleo",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "ELECTRON_START_URL=http://localhost:5173 electron .",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "start": "npm run build && electron .",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && npm run verify:security && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --universal",
    "verify:security": "electron scripts/security-check.cjs",
    "screenshots": "npm run build && electron scripts/screenshots.cjs",
    "dist:signed": "npm run build && npm run verify:security && electron-builder --mac --universal",
    "test:all": "node scripts/run-tests.mjs",
    "build:e2e": "vite build --ssr src/apps/forms/e2e-roundtrip.ts --outDir .tmp-e2e",
    "test:forms-e2e": "npm run build:e2e && electron scripts/forms-e2e.cjs",
    "test:ui": "npm run build && electron scripts/forms-ui-e2e.cjs",
    "test:pivot-ui": "npm run build && electron scripts/pivot-ui-e2e.cjs",
    "test:contrast": "npm run build && electron scripts/contrast-check.cjs",
    "test:charts": "npm run build && npm run build:chartgeom && electron scripts/charts-ui-e2e.cjs",
    "build:chartgeom": "vite build --ssr src/apps/sheets/chartGeom.ts --outDir .tmp-chart-geom",
    "test:pivot": "npm run build && electron scripts/pivot-ui-e2e.cjs"
  },
  "devDependencies": {
    "@tiptap/extension-highlight": "^3.28.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-list": "^3.28.0",
    "@tiptap/extension-subscript": "^3.28.0",
    "@tiptap/extension-superscript": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-text-align": "^3.28.0",
    "@tiptap/extension-text-style": "^3.28.0",
    "@tiptap/extensions": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "docx": "^9.7.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^16.4.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "com.anleo.office",
    "productName": "Anleo Office",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "adoc",
          "name": "Anleo Docs Document",
          "role": "Editor"
        },
        {
          "ext": "asheet",
          "name": "Anleo Sheets Spreadsheet",
          "role": "Editor"
        },
        {
          "ext": "aslides",
          "name": "Anleo Slides Presentation",
          "role": "Editor"
        },
        {
          "ext": "aform",
          "name": "Anleo Forms Form",
          "role": "Editor"
        }
      ]
    }
  }
}
