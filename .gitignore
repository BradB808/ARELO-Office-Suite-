# Dependencies
node_modules/

# Build output
dist/
release/
.tmp-*/

# Screenshots are committed on purpose (docs/screenshots) — nothing else here is

# Editor / tooling
.claude/
.vscode/
.idea/
*.swp

# macOS
.DS_Store
.AppleDouble
.LSOverride
# The custom-folder-icon file is literally named "Icon\r". Match it exactly —
# a bare `Icon?` also swallows build/icons/, because git on macOS matches
# case-insensitively, which silently dropped the app icon artwork from the repo.
Icon[\r]
._*

# Logs and local scratch
*.log
npm-debug.log*
.env
.env.*
*.local

# Never commit a real key or a personal document
*.pem
*.p12
*.mobileprovision
secrets.json
